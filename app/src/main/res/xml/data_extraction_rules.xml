<?xml version="1.0" encoding="utf-8"?>
<!--
  Android-Auto-Backup und Gerätetransfer sind vollständig ausgeschlossen (ARCHITECTURE.md, I-3):
  Die Datenbank ist mit einem Keystore-Schlüssel geschützt, der nicht mitwandert. Eine wiederhergestellte
  DB ohne Schlüssel wäre unlesbar. Sicherungen erfolgen über das eigene verschlüsselte Backup (Phase 3).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
